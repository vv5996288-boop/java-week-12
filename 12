<%@ taglib uri="http://java.sun.com/jsp/jstl/core" prefix="c" %>
<html>
<head>
    <title>JSTL Core Tags Demo</title>
</head>
<body>
<h2>JSTL Core Tags Example</h2>
<!-- set variable -->
<c:set var="name" value="Ravi Kumar" />
<c:set var="marks" value="75" />
<!-- output -->
Name: <c:out value="${name}" />
<br>
Marks: <c:out value="${marks}" />
<br><br>
<!-- if condition -->
<c:if test="${marks >= 50}">
    <h3>Status: Pass</h3>
</c:if>
<c:if test="${marks < 50}">
    <h3>Status: Fail</h3>
</c:if>
<br>
<!-- forEach loop -->
<h3>Number List:</h3>
c:forEach var="i" begin="1" end="5">
    Number: <c:out value="${i}" />
    <br>
</c:forEach>

</body>
</html>
